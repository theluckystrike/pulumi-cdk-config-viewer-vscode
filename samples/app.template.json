{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sample synthesized AWS CDK stack template",
  "Parameters": {
    "EnvName": {
      "Type": "String",
      "Default": "prod"
    }
  },
  "Resources": {
    "AppAssetsBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "example-app-assets-prod"
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Policies": [
          {
            "PolicyName": "BroadPolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "*",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "WebSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Web tier",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": { "Ref": "AppAssetsBucket" }
    }
  }
}
